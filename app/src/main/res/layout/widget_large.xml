                android:text="--%"
                android:textColor="@color/widget_primary"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="1dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="8dp">
            <TextView
                android:id="@+id/day4_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="---"
                android:textColor="@color/widget_on_surface_variant"
                android:textSize="12sp" />
            <ImageView
                android:id="@+id/day4_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginVertical="6dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_w_cloudy" />
            <TextView
                android:id="@+id/day4_high"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="--°"
                android:textColor="@color/widget_on_surface"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/day4_low"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="--°"
